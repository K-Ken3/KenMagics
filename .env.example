# Copy to .env.local and fill in. Never commit real keys.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Server-only. Bypasses RLS for seeding and webhook revalidation.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# First admin account: create it in Supabase Auth, then add the same
# email to public.admin_allowed_emails (the seed script does this if
# ADMIN_EMAIL is set).
ADMIN_EMAIL=karasiraken5@gmail.com

# Optional: contact form email notifications
RESEND_API_KEY=
CONTACT_TO_EMAIL=karasiraken5@gmail.com
CONTACT_FROM_EMAIL=KenDesigns <onboarding@resend.dev>

# Optional: protects POST /api/revalidate (Supabase webhook or manual curl)
REVALIDATE_SECRET=
